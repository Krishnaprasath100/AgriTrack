# AgriTrack Environment Configuration

# PostgreSQL Database Connection String
# Standard formats supported:
# Local PostgreSQL: postgresql://postgres:password@localhost:5432/agritrack
# Supabase Pooler: postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Neon / Serverless: postgresql://username:password@ep-cool-forest-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agritrack

# Alternative individual PostgreSQL parameters (Optional if DATABASE_URL is provided):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=agritrack

# Application Secret Key (for sessions & signing)
NEXTAUTH_SECRET=agritrack_secret_key_production_2026
NEXT_PUBLIC_APP_URL=http://localhost:3000

# KovaiSMS transactional SMS settings (keep credentials server-side only)
SMS_ACCESS_TOKEN=
SMS_ACCESS_TOKEN_KEY=
SMS_GATEWAY_URL=https://kovaisms.com/api/sms/v1.0/send-sms
SMS_ROUTE=7
SMS_HEADER=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
SMS_MESSAGE_TEMPLATE=Your AgriTrack verification OTP is {#var#}. Valid for 10 minutes. Do not share this code.

